# Neon Postgres connection string (from your Neon project dashboard).
# Use the "pooled" connection string Neon gives you.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Random long secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Used once by `npm run db:seed` to create the first Administrator account.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@dspace.co.in"
ADMIN_PASSWORD="ChangeMe123!"
