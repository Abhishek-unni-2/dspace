# Neon Postgres connection string (from your Neon project dashboard).
# Use the "pooled" connection string Neon gives you.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Random long secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Used once by `npm run db:seed` to create the first Administrator account.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@dspace.co.in"
ADMIN_PASSWORD="ChangeMe123!"

# Google Sheet of Meta lead-ad leads to import automatically (the long id in the
# sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit). Must be shared as
# "Anyone with the link".
LEADS_SHEET_ID="your-google-sheet-id"
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does this automatically).
CRON_SECRET="replace-with-another-long-random-string"
# Optional. Each sync imports sheet leads from the last N days (default 3); already-imported leads are skipped.
# LEADS_SYNC_DAYS="3"

# SMS alert to each salesperson's own mobile when leads are assigned (optional; unset = off).
# Mobile numbers are saved per user in Admin -> Users. See src/lib/sms.ts for the DLT template text.
# SMS_PROVIDER="msg91"        # or "fast2sms"
# SMS_API_KEY=""
# SMS_TEMPLATE_ID=""
# SMS_SENDER_ID=""            # Fast2SMS only
